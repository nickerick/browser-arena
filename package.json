{
  "name": "browser-arena",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t browser-arena .",
    "docker:run": "docker run --rm -p 3001:3001 browser-arena",
    "docker:start": "npm run docker:build && npm run docker:run"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
